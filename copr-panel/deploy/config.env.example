# onetapclash 部署参数。复制成 config.env 再填。config.env 已 gitignore。
# 只有 DOMAIN 必填;SUI_USER / SUI_PASS 留空会在全量部署时询问;其余留空走默认值。
DOMAIN=example.com                # 必填,已解析到本机的域名
SUI_USER=                         # 留空 → 运行时询问(默认 admin)
SUI_PASS=                         # 留空 → 运行时询问,两次确认;直接回车则自动生成强密码
                                  #        建议留空,别把密码落盘

# --- 面板 / 订阅 ---
PANEL_DIR=/opt/copr-panel/web
PANEL_PATH=/panel/
SUI_PORT=2095
SUI_BASE=/app/
SUI_SUB_PORT=2096
SUI_SUB_PATH=/sub/

# --- converter ---
CONV_DIR=/opt/sui-converter
CONV_ADDR=127.0.0.1:25501
CONV_ADMIN_SECRET=                # 留空 → 沿用已部署的;首次部署自动生成

# --- 证书 ---
CERT_MODE=le                      # le=Let's Encrypt;其他值=自备证书
TLS_PORT=443
# 旧 HTTPS 端口(迁移用):填了 nginx 同时监听它,已发出去的 https://域名:旧端口/get/ 不断。新装留空
TLS_PORT_LEGACY=
TLS_CERT=                         # 留空 → /etc/letsencrypt/live/$DOMAIN/fullchain.pem
TLS_KEY=

# --- 自动开的节点(跑完就能用,你只要加会员)---
HY2_TAG=quick
HY2_PORT=443                      # UDP;nginx 占的是 TCP 443,不冲突
WANT_REALITY=yes
REALITY_TAG=reality
REALITY_PORT=8443                 # TCP;443/tcp 给 nginx
REALITY_DEST=www.apple.com        # Reality 握手目标,需 TLS1.3 且非 CDN

# --- 线路稳定 / 速率 ---
HOP_ENABLE=yes                    # Hysteria2 端口跳跃,抗运营商对固定 UDP 端口的 QoS
HY2_HOP_PORTS=20000-25000         # 对外的 UDP 端口段,服务端全部重定向到 HY2_PORT
HY2_HOP_INTERVAL=30               # 客户端换端口间隔(秒),可写 "15-30" 随机
HY2_OBFS=yes                      # salamander 混淆,抗主动探测/DPI 识别 QUIC
HY2_OBFS_PASSWORD=                # 留空=沿用节点上已有的,都没有则自动生成(会打印,请存回这里)
# Brutal 固定速率拥塞控制:两个都填才启用,留空=用 BBR(自适应,安全)。
# 必须填【客户端实测】的稳定速率 ×80%,不是服务器出口速率 —— 服务器在东京测到
# 500Mbps,不代表广东的用户能跑到。Brutal 不退让,高估就是持续丢包,比不开更糟。
HY2_UP_MBPS=
HY2_DOWN_MBPS=

# --- IPv6 ---
# 服务器有公网 IPv6 且域名加了 AAAA → yes。订阅里打开客户端 IPv6(否则 mihomo 拒绝拨 v6),
# 端口跳跃同时加 v6 规则。IPv4 被墙时 IPv6 往往还通,只留 AAAA 就能应急。
IPV6=no

# --- 安全 ---
HARDEN=yes                        # fail2ban + ufw + sshd 开公钥登录 + 自动安全更新
SSH_PORT=22
# yes = 关掉 SSH 密码登录,只留密钥。先确认密钥能登上再开;authorized_keys 为空时会拒绝执行
DISABLE_PASSWORD_AUTH=no
# fail2ban 白名单,空格分隔;加上你自己的固定出口 IP,防止输错几次把自己封了
F2B_IGNOREIP=127.0.0.1/8 ::1

# --- 其他 ---
SWAP_MB=1024                      # 机器没有 swap 时建的 swapfile 大小(MB);0 = 不建

# --- push.sh 用(本地开发机→服务器)---
SSH_HOST=root@1.2.3.4
SSH_KEY=
