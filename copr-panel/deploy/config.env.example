# onetapclash 部署参数。复制成 config.env 再填。config.env 已 gitignore。
# 只有 DOMAIN / SUI_USER 是必填;其余留空走默认值。
DOMAIN=example.com                # 必填,已解析到本机的域名
SUI_USER=admin                    # s-ui 管理员账号
SUI_PASS=                         # 留空 → bootstrap 交互询问(建议留空,别把密码落盘)

# --- 面板 / 订阅 ---
PANEL_DIR=/opt/copr-panel/web
PANEL_PATH=/panel/
SUI_PORT=2095
SUI_BASE=/app/
SUI_SUB_PORT=2096
SUI_SUB_PATH=/sub/
SUI_ADDR=127.0.0.1:2095           # nginx 反代 s-ui 用的本机地址

# --- converter ---
CONV_DIR=/opt/sui-converter
CONV_ADDR=127.0.0.1:25501
CONV_ADMIN_SECRET=                # 留空 → 自动生成

# --- 证书 ---
CERT_MODE=le                      # le=Let's Encrypt;其他值=自备证书
TLS_PORT=443
TLS_CERT=                         # 留空 → /etc/letsencrypt/live/$DOMAIN/fullchain.pem
TLS_KEY=

# --- 自动开的节点(跑完就能用,你只要加会员)---
HY2_TAG=quick
HY2_PORT=443                      # UDP;nginx 占的是 TCP 443,不冲突
WANT_REALITY=yes
REALITY_TAG=reality
REALITY_PORT=8443                 # TCP;443/tcp 给 nginx
REALITY_DEST=www.apple.com        # Reality 握手目标,需 TLS1.3 且非 CDN

# --- 安全 ---
HARDEN=yes                        # fail2ban + ufw + sshd 开公钥登录
SSH_PORT=22

# --- push.sh 用(本地开发机→服务器)---
SSH_HOST=root@1.2.3.4
SSH_KEY=
